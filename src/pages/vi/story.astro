---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import { localeFromPath } from '../../data/content';

const t = localeFromPath(Astro.url.pathname);
const s = t.story;
// The "day we met" photo is hosted externally (Venuu), not in src/assets.
const firstDateImg = 'https://files.venuu.se/attachments/000/265/972/26b798e0af7d85c06d6f8acfd20cdc8e6d01dd9d.jpg';
const firstDateAlt = t.code === 'vi' ? 'L\u1EA7n \u0111\u1EA7u g\u1EB7p nhau' : 'The first time we met';
---

<Layout title={s.title}>
  <section class="page">
    <div class="prose">
      <h1 class="page__title">{s.title}</h1>
      <p class="lede">{s.lede}</p>

      {
        s.sections.map((section, i) => (
          <section class="story__section">
            <h2 class="story__heading">{section.heading}</h2>
            <p class="story__date"><strong>{t.code === 'vi' ? 'Ng\u00E0y' : 'Date'}:</strong> {section.date}</p>
            {section.body && <p class="story__body">{section.body}</p>}
            {section.images.map((img) => (
              <Photo src={img.src} alt={img.alt} />
            ))}
            {section.images.length === 0 && i === 1 && (
              <figure class="story__ext-figure">
                <img src={firstDateImg} alt={firstDateAlt} loading="lazy" />
              </figure>
            )}
          </section>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .story__section {
    margin-top: 2.4rem;
  }
  .story__heading {
    font-family: var(--serif-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 3.2vw, 2rem);
    margin-bottom: 0.6rem;
  }
  .story__date {
    color: var(--muted);
    font-style: italic;
    margin-bottom: 0.8rem;
  }
  .story__body {
    margin-bottom: 1.2rem;
  }
  .story__ext-figure {
    margin: 1rem 0;
  }
  .story__ext-figure img {
    width: 100%;
    border-radius: 4px;
  }
</style>
