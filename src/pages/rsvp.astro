---
import Layout from '../layouts/Layout.astro';
import { localeFromPath } from '../data/content';

const t = localeFromPath(Astro.url.pathname);
const r = t.rsvp;
const formUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSc_ClCpEs5ybKZjQmJ8qLgbppD_9QCslDQXcabpEeNPAqxuAA/viewform?embedded=true';
// ponytail: deadline is markdown-bold in the source; render the bold inline.
const deadlineHtml = r.deadline.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<Layout title={r.title}>
  <section class="page">
    <div class="prose">
      <h1 class="page__title">{r.title}</h1>
      <p class="lede">{r.intro}</p>
      <p set:html={deadlineHtml}></p>
      <div class="rsvp__note">
        <strong>⚠️ {r.noteLabel}</strong>
        <p>{r.note}</p>
      </div>
      <iframe class="rsvp__form" src={formUrl} loading="eager">Loading…</iframe>
    </div>
  </section>
</Layout>

<style>
  .rsvp__note {
    margin: 1.5rem 0;
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--brand);
    background: var(--line);
    border-radius: 4px;
  }
  .rsvp__note p {
    margin: 0.5rem 0 0;
  }
  .rsvp__form {
    width: 100%;
    height: 1505px;
    border: 0;
    margin-top: 1.5rem;
  }
</style>
