---
import { photosUrl, captionFromFilename } from '../lib/photos';

// A single in-post photo, served straight from the bucket original and wired to
// the shared Lightbox. Reference it by filename (no import needed):
//
//     <Photo src="lake-erie-fog.jpg" caption="Lake Erie, fog" />
//
interface Props {
  src: string; // filename within the bucket's blog/ prefix (subfolders allowed)
  alt?: string; // defaults to the caption, else derived from the filename
  caption?: string; // optional visible caption (also shown in the lightbox)
}
const { src, alt, caption } = Astro.props;

const url = photosUrl('blog', src);
const altText = alt ?? caption ?? captionFromFilename(src);
---

<figure class="post-figure">
  <button
    class="photo-tile"
    type="button"
    aria-label={`${altText} — view larger`}
    data-full={url}
    data-alt={altText}
    data-caption={caption ?? ''}
  >
    <img
      class="photo__img"
      src={url}
      alt={altText}
      loading="lazy"
      decoding="async"
      draggable={false}
    />
  </button>
  {caption && <figcaption class="post-figure__caption">{caption}</figcaption>}
</figure>
