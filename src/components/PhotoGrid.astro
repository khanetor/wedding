---
import { photosUrl, captionFromFilename } from '../lib/photos';
import Lightbox from './Lightbox.astro';
import { site as siteInfo } from '../config';
import { digital as digitalOrder } from '../data/galleries';

// Display order lives in src/data/galleries.ts (a string[]) and matches the
// filenames uploaded to the bucket's digital/ prefix.
const photos = digitalOrder.map((file, i) => ({
  src: photosUrl('digital', file),
  alt: captionFromFilename(file, i),
}));

// Structured data: a simple ImageGallery of ImageObjects.
const base = Astro.site ? Astro.site.href.replace(/\/$/, '') : '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: `${siteInfo.name} — Gallery`,
  url: `${base}${Astro.url.pathname}`,
  image: photos.map((p) => ({
    '@type': 'ImageObject',
    contentUrl: p.src,
    name: p.alt,
  })),
};
---

{
  photos.length === 0 ? (
    <p class="empty">
      No photos yet. Put originals in <code>photos/digital/</code>, list them in <code>galleries.ts</code>, and upload them to the bucket.
    </p>
  ) : (
    <section class="calendar-grid" aria-label="Wedding photographs">
      {photos.map((photo, i) => (
        <figure class="calendar-item">
          <button
            class="photo-tile"
            type="button"
            aria-label={`${photo.alt} — view larger`}
            data-full={photo.src}
            data-alt={photo.alt}
          >
            <img
              class="photo__img"
              src={photo.src}
              alt={photo.alt}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
              draggable={false}
            />
          </button>
        </figure>
      ))}
    </section>
  )
}

<Lightbox />

{Astro.site && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
